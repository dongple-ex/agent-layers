// Keep this file outside the repository it works on: a new file there counts as an uncommitted change.
{
  "schemaVersion": 1,
  "provider": {
    // The command gets its instructions on stdin and must print its final message on stdout.
    // The flags below belong to the CLI and can change with it, so check them with its --help.
    "command": "codex",
    "args": ["exec", "-c", "approval_policy=never", "--sandbox", "workspace-write", "-"],
    "roleArgs": {
      "planner": ["exec", "-c", "approval_policy=never", "--sandbox", "read-only", "-"],
      "reviewer": ["exec", "-c", "approval_policy=never", "--sandbox", "read-only", "-"],
      "auditor": ["exec", "-c", "approval_policy=never", "--sandbox", "read-only", "-"]
    },
    // Names of environment variables to pass on, on top of PATH, the home folders and the temp folders.
    // Values never go in this file.
    "env": []
    // Claude Code: "command": "claude", "args": ["-p", "--permission-mode", "acceptEdits", "--tools", "Read,Edit,Write,Grep,Glob,Bash", "--allowedTools", "Bash(node --test*)"],
    // and ["-p", "--tools", "Read,Grep,Glob"] for the planner, reviewer and auditor. Put your own test command in --allowedTools.
    // On Windows a .cmd file cannot start without a shell, so name the program it starts:
    // "command": "node", and the path of the package's bin script as the first item of each args list.
  },
  "allowedWritePaths": ["src", "test"],
  "protectedPaths": ["package.json"],
  // Optional: commands that run once in the worktree before the first check, with the same environment as the checks.
  // A setup command must leave tracked files alone, and git must ignore what it creates, so prefer "npm ci" to "npm install".
  // "setup": [{ "id": "install", "command": "npm", "args": ["ci"], "timeout": 600 }],
  "checks": [
    // Every check the plan uses runs once at the base commit before any AI call.
    // "baseline": "pass" is the default. Use "fail" for a check that must fail there, such as a new acceptance test.
    // "inputs": existing files under these paths cannot be changed or deleted during the run, so the AI CLI cannot weaken the check.
    // New files are allowed. Leave it out if the goal needs to change those files.
    // "failedTestPattern": optional regular expression with one capture group that finds failing test names in the log.
    // On Windows, "npm" is a .cmd file too; use "node" with the test runner there.
    { "id": "unit", "command": "npm", "args": ["test"], "timeout": 600, "inputs": ["test"] }
  ],
  "requiredChecks": ["unit"]
}
